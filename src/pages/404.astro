---
import { siteConfig } from "../config";
import "../styles/global.css";

const title = `Page not found - ${siteConfig.name}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content="This page could not be found." />
    <meta name="theme-color" content={siteConfig.accentColor} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <main
      class="relative isolate overflow-hidden bg-white min-h-screen flex items-center"
      style={`--accent-color: ${siteConfig.accentColor}`}
    >
      <div
        class="absolute inset-0 -z-10"
        style={`background: radial-gradient(ellipse 800px 1200px at 0% 0%, ${siteConfig.accentColor}40 0%, ${siteConfig.accentColor}25 20%, ${siteConfig.accentColor}10 40%, rgba(255, 255, 255, 0.3) 70%, rgba(255, 255, 255, 0.8) 90%, white 100%)`}
      >
      </div>

      <div class="p-8 sm:p-12 md:p-24">
        <p
          class="text-pretty text-xl sm:text-2xl md:text-5xl font-bold tracking-tight text-gray-700"
        >
          404
        </p>
        <h1
          class="mt-6 sm:mt-8 md:mt-10 text-pretty text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-gray-800"
        >
          This page doesn't <span style={{ color: siteConfig.accentColor }}
            >exist</span
          >
        </h1>
        <p
          class="mt-4 sm:mt-6 md:mt-8 text-pretty text-base sm:text-lg md:text-xl/8 font-medium text-gray-600"
        >
          The link may be out of date, or the page may have moved.
        </p>
        <a
          href="/"
          class="mt-6 sm:mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-gray-900 text-white font-medium shadow hover:scale-105 transition-all"
        >
          Back to the homepage
        </a>
      </div>
    </main>
  </body>
</html>
